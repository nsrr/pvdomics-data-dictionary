#   mutate(across(everything(), ~ ifelse(is.na(.), "", .)))
#write.csv(df_h, "/Volumes/bwh-sleepepi-nsrr-staging/20241025-pvdomics/nsrr-prep/_releases/0.1.0.pre/pvdomics-harmonized-dataset-0.1.0.csv", row.names = F, na = "")
write.csv(df_h, "/Volumes/bwh-sleepepi-nsrr-staging/20241025-pvdomics/nsrr-prep/_releases/0.1.0.pre2/pvdomics-harmonized-dataset-0.1.0.csv", row.names = F, na = "")
